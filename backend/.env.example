# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS (Frontend URL)
FRONTEND_URL=http://localhost:5173

# LLM via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=google/gemini-flash-1.5

